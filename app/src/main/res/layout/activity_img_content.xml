<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".imgContentActivity">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".imgContentActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:title="画像管理アプリ"
                />
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                <LinearLayout
                    xmlns:android="http://schemas.android.com/apk/res/android"
                    android:layout_width="match_parent"
                    android:layout_height="450dp"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:id="@+id/leftButton"
                        android:layout_width="30dp"
                        android:layout_height="450dp"
                        android:text="&lt;"
                        android:textSize="80dp"
                        android:gravity="center"/>
                        <ImageView
                            android:id="@+id/mainImgFrame"
                            android:layout_width="340dp"
                            android:layout_height="450dp"
                            android:src="@drawable/sample"
                            android:scaleType="fitCenter"
                            android:background="#EEEEEE"/>
                    <TextView
                        android:id="@+id/rightButton"
                        android:layout_width="35dp"
                        android:layout_height="450dp"
                        android:text="&gt;"
                        android:textSize="80dp"
                        android:gravity="center"/>


                </LinearLayout>
                <LinearLayout
                    xmlns:android="http://schemas.android.com/apk/res/android"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/imageIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"/>
                    <TextView
                        android:id="@+id/imageIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="● ○ ○ ○ ○"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:textColor="#4169e1"
                        android:layout_gravity="center"/>

                </LinearLayout>
                    <TextView
                        android:id="@+id/imageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sample"
                        android:textSize="25sp"
                        android:layout_gravity="center"
                        android:padding="5dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_margin="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#DDDDDD" />

                        <TextView
                            android:id="@+id/imgTagShelf"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="+ 所有しているTag"
                            android:textSize="18dp"
                            android:padding="12dp"/>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#DDDDDD" />

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/currentTagContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            app:flexDirection="row"
                            app:flexWrap="wrap"
                            app:justifyContent="flex_start">


                        </com.google.android.flexbox.FlexboxLayout>

                    </LinearLayout>
                    <Button
                        android:id="@+id/saveButton"
                        android:backgroundTint="@null"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="保存"
                        android:textColor="#ffffff"
                        android:textSize="18sp"
                        android:background="@drawable/red_square"
                        android:layout_margin="10dp"
                        />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/closeImg"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="閉じる"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:singleLine="true"
                            android:layout_marginTop="20dp"
                            android:layout_gravity="center"
                            android:textColor="#4169e1" />
                        <View
                            android:layout_width="80dp"
                            android:layout_height="2dp"
                            android:background="#4169e1"
                            android:layout_marginBottom="17dp"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/editButton"
                        android:backgroundTint="@null"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="編集"
                        android:textColor="#ffffff"
                        android:textSize="18sp"
                        android:background="@drawable/red_square"
                        android:layout_margin="10dp"
                        android:layout_weight="1"
                        />

                </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="100dp" />

                </LinearLayout>
            </ScrollView>



        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>